# npm security best practices
# Source: https://github.com/lirantal/npm-security-best-practices

# SECURITY: do not run any lifecycle scripts (postinstall, etc)
ignore-scripts=true

# SECURITY: reject git-source dependencies (git+ssh:// etc)
allow-git=none

# SECURITY: automatic vulnerability auditing
audit=true
audit-level=moderate

# SECURITY: always use lockfiles for deterministic installs
package-lock=true

# SECURITY: enforce Node.js engine requirements
engine-strict=true

# Reduce noise
fund=false

# NOTE: min-release-age is handled globally by mise (minimum_release_age = "7d")
# which applies to npm, pipx, cargo, and all other backends
